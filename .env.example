# Copy to .env, fill locally, then export it as described in README.md.
# The server does not load .env automatically. Never commit populated credentials.
HOST_KEY=replace-with-a-random-password-at-least-16-characters
APP_BASE_URL=http://localhost:8080
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8080/auth/callback
STORY_API_KEY=
STORY_MODEL=
STORY_API_URL=https://api.openai.com/v1/chat/completions
# Optional: default is data/streamquest.db; keep custom database paths private.
# DATABASE_PATH=data/streamquest.db
# PORT=8080
